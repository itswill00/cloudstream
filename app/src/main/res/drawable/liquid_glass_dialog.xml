<?xml version="1.0" encoding="utf-8"?>
<!-- The glass panel of a dialog, it is translucent so that the background
     shows through it, the line at the edge is the light on the edge of the
     glass. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android">
    <shape android:shape="rectangle">
        <corners android:radius="10dp" />
        <solid android:color="#B312151D" />
        <stroke
            android:width="1dp"
            android:color="#33FFFFFF" />
    </shape>
</inset>
