<?xml version="1.0" encoding="utf-8"?>
<!-- The glass panel of a dialog. It has to be translucent, an opaque
     background hides the blur of the system. The line at the edge is the light
     on the edge of the glass. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android">
    <shape android:shape="rectangle">
        <corners android:radius="10dp" />
        <solid android:color="#6612151D" />
        <stroke
            android:width="1dp"
            android:color="#33FFFFFF" />
    </shape>
</inset>
