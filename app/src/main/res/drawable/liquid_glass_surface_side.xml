<?xml version="1.0" encoding="utf-8"?>
<!-- The glass surface of the navigation rail on the side of the screen, the
     bright line is on the right edge, that is the edge that catches the light. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#26FFFFFF"
                android:startColor="#0AFFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:gravity="right"
        android:width="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
