<?xml version="1.0" encoding="utf-8"?>
<!-- The header at the top of the home screen.

     It used to be three stacked gradients, which painted the whole top of the
     screen blue and teal. The colour is now a single soft wash, because the
     glass only needs a hint of colour to refract, and a strong tint made the
     text on top of it hard to read. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#0F3D50FA"
                android:endColor="#000A0B11"
                android:startColor="#263D50FA"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:gravity="bottom"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
