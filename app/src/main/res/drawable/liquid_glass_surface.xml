<?xml version="1.0" encoding="utf-8"?>
<!-- The glass surface of the navigation bar at the bottom of the screen.
     It is translucent, so the background shows through it, the bright line at
     the top is the light that hits the edge of the glass. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#26FFFFFF"
                android:startColor="#0AFFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
