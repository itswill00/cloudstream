<?xml version="1.0" encoding="utf-8"?>
<!-- The background of the app in the Liquid Glass theme.

     The content layer is a standard material, not glass. Liquid Glass belongs
     to the functional layer, the controls and the navigation that float above
     the content, so the background stays a plain dark surface and the glass is
     left to the bars. A subtle wash of colour is kept near the top so the bars
     have something to refract, without painting the whole screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/LiquidGlassBitDarkerGrayBackground" />
    </item>
    <item
        android:gravity="top"
        android:height="320dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#0F3D50FA"
                android:endColor="#000A0B11"
                android:startColor="#263D50FA"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
