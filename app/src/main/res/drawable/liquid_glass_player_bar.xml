<?xml version="1.0" encoding="utf-8"?>
<!-- The panel behind the controls of the player. It is on top of the video,
     so it is dark and translucent, the line at the top is the light on the
     edge of the glass. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="90"
                android:endColor="#B3000000"
                android:startColor="#73000000"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
