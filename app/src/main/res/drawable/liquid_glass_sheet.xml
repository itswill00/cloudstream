<?xml version="1.0" encoding="utf-8"?>
<!-- The glass surface of a bottom sheet, the bright line is at the top edge
     where the light hits the glass. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp" />
            <solid android:color="#B312151D" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
